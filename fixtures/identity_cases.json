    {
      "name": "all valid",
      "input": {
        "service": "web-app",
        "domain": "tender_management",
        "environment": "dev",
        "version": "1.2.3"
      },
      "identity": {
        "service": "web-app",
        "domain": "tender_management",
        "environment": "dev",
        "version": "1.2.3"
      }
    },
    {
      "name": "environment trimmed and lower-cased",
      "input": {
        "service": "web-app",
        "domain": "tender_management",
        "environment": "  PROD ",
        "version": "1.2.3"
