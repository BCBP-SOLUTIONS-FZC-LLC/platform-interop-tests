  "strings": [
    {
      "name": "plain text unchanged",
      "input": "hello world",
      "expected": "hello world"
    },
    {
      "name": "NUL removed",
      "input": "a\u0000b",
      "expected": "ab"
    },
    {
      "name": "newline and carriage return removed",
      "input": "line1\r\nline2",
      "expected": "line1line2"
    },
    {
      "name": "tab removed",
      "input": "a\tb",
      "expected": "ab"
    },
    {
      "name": "DEL removed",
      "input": "a\u007fb",
      "expected": "ab"
    },
    {
      "name": "C1 control NEL removed",
      "input": "a\u0085b",
      "expected": "ab"
    },
    {
      "name": "C1 control CSI removed",
      "input": "a\u009bb",
      "expected": "ab"
    },
    {
      "name": "zero-width space kept (format, not control)",
      "input": "a\u200bb",
      "expected": "a\u200bb"
    },
    {
      "name": "non-ASCII letters kept",
      "input": "caf\u00e9 \u00f1 \u65e5\u672c \u0645\u0631\u062d\u0628\u0627",
