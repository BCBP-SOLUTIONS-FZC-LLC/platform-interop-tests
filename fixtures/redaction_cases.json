    },
    {
      "name": "emoji kept",
      "input": "ok \ud83d\udc4d",
      "expected": "ok \ud83d\udc4d"
    },
    {
      "name": "line separator: kept by the backends, removed by the SDK",
      "input": "a\u2028b",
      "expected": "a\u2028b",
      "expectedSdk": "ab"
    },
    {
      "name": "paragraph separator: kept by the backends, removed by the SDK",
      "input": "a\u2029b",
      "expected": "a\u2029b",
      "expectedSdk": "ab"
    },
    {
      "name": "empty string",
      "input": "",
      "expected": ""
    },
    {
      "name": "exactly 256 bytes unchanged",
